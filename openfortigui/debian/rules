#!/usr/bin/make -f

# Plain CMake build. Buildflags per Debian policy flow through debhelper's
# cmake build system automatically, and installation is handled by the
# install() rules in CMakeLists.txt, so nothing is copied by hand.
%:
	dh $@ --buildsystem=cmake

override_dh_builddeb:
	dh_builddeb -- -Zxz
