#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

# The build system is plain cmake and the install rules in CMakeLists.txt are
# correct now, so nothing has to be copied by hand any more. Two KDE-specific
# paths do have to be pointed at Debian's layout: KDEInstallDirs would otherwise
# guess the library directory, and KRunner only finds plugins that sit in Qt's
# plugin directory.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
	    -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
	    -DKDE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH)

override_dh_builddeb:
	dh_builddeb -- -Zxz
